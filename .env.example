# POSTGRES
POSTGRES_USER=rental
POSTGRES_PASSWORD=
POSTGRES_DB=rentalpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RUSTFS
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_ENDPOINT=localhost:9000
